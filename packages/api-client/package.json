{
  "name": "@meki/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed contract for the MEKI API: request types generated from openapi.json + public response types",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/generated/schema.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "^7",
    "typescript": "~5.9.3"
  }
}
