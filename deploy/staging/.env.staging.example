# MEKI staging — variable NAMES only (docs/51 §4). Values live in the hosting secret store, or for a local rehearsal in
# deploy/staging/.env.staging generated by `node deploy/staging/init-secrets.mjs` (git-ignored, never committed).
MYSQL_ROOT_PASSWORD=
MEKI_MIGRATOR_PASSWORD=
MEKI_APP_DB_PASSWORD=
EVENT_BOOKING_TOKEN_SECRET=
DONATION_TOKEN_SECRET=
# Public origins (hosted staging: https, not localhost)
STAGING_WEB_URL=https://staging.example.org
STAGING_ADMIN_URL=https://admin.staging.example.org
STAGING_API_URL=https://api.staging.example.org
# true ONLY for an on-machine rehearsal over http://localhost; refused in production
STAGING_LOCAL_REHEARSAL=false
# reverse-proxy hop count in front of the API
TRUST_PROXY=1
