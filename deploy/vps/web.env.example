# MEKI public website (meki-web, PM2, 127.0.0.1:3000) — NAMES and non-secret example values only. Never commit real values.
#
# ── BUILD-TIME (public, inlined into the browser bundle by `next build`; changing one requires a rebuild) ──
# Export these in the shell that runs the build (deploy/vps/deploy.sh reads /etc/meki/web.build.env). None of them is a secret.
MEKI_DEPLOY_ENV=production
NEXT_PUBLIC_API_URL=https://api.meki-us.org/api/v1
NEXT_PUBLIC_SITE_URL=https://meki-us.org
# Hosted-checkout hosts the MEKI reference flow may redirect to after creating an EB-/DN- reference (comma separated).
NEXT_PUBLIC_CHECKOUT_ALLOWED_HOSTS=www.zeffy.com
# Release switches for the hand-off to SDI's two OFFICIAL Zeffy Gala forms. Only "true" enables one. OFF until SDI opens the form.
NEXT_PUBLIC_GALA_TICKET_FORM_HANDOFF=false
NEXT_PUBLIC_GALA_DONATION_FORM_HANDOFF=false
#
# ── RUNTIME (server-side only; /etc/meki/web.env, loaded by PM2 via node --env-file) ──
NODE_ENV=production
# Server-side rendering calls the API over loopback (no TLS, no public hop). Not exposed to the browser.
API_INTERNAL_URL=http://127.0.0.1:6666/api/v1
