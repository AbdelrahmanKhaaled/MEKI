# MEKI admin dashboard (meki-admin, PM2, 127.0.0.1:3001) — NAMES and non-secret example values only.
#
# ── BUILD-TIME (rewrites are compiled by `next build`; /etc/meki/admin.build.env) ──
MEKI_DEPLOY_ENV=production
# Absolute https origin of the API, WITHOUT /api/v1. The build fails for a hosted target if it is missing, http or localhost.
# On the VPS nginx already routes admin.meki-us.org/api/v1 straight to the API; this rewrite is the fallback path.
ADMIN_API_UPSTREAM=https://api.meki-us.org
#
# ── RUNTIME (/etc/meki/admin.env, loaded by PM2 via node --env-file) ──
NODE_ENV=production
