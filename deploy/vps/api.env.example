# /etc/meki/api.env on the VPS (root:meki, 0640) — NAMES and non-secret values only (docs/54 §1). Never commit real values.
# Every secret must be freshly generated for the VPS: never reuse a value from a developer machine, screenshot or staging.
NODE_ENV=production
PORT=6666
API_BIND_HOST=127.0.0.1
# loopback MySQL 8.0 (caching_sha2_password over plain TCP on 127.0.0.1 needs allowPublicKeyRetrieval; never use it over a network)
DATABASE_URL=mysql://meki_app:<password>@127.0.0.1:3306/meki?allowPublicKeyRetrieval=true
# Public origins (https only; the API refuses localhost/http values in production)
WEB_URL=https://meki-neon.vercel.app
API_PUBLIC_URL=https://api.example.org
PUBLIC_MEDIA_BASE_URL=https://api.example.org/media
CORS_ORIGINS=https://meki-neon.vercel.app,https://admin-anhk.vercel.app
DONATION_RETURN_URL=https://meki-neon.vercel.app/{locale}/donation/return
EVENT_BOOKING_RETURN_URL=https://meki-neon.vercel.app/{locale}/events/{slug}/booking
# nginx on the same host = 1 hop. If the admin is proxied by Vercel, verify the client-IP header chain before changing (docs/52 R-4).
TRUST_PROXY=1
EVENT_BOOKING_TOKEN_SECRET=<48+ random characters>
DONATION_TOKEN_SECRET=<48+ random characters>
LOCAL_STORAGE_DIR=/var/lib/meki/uploads
PRIVATE_STORAGE_DIR=/var/lib/meki/private
LOG_FORMAT=json
LOG_LEVEL=log
SWAGGER_ENABLED=false
MAIL_TRANSPORT=none
# ── financial / fundraising switches: ALL OFF until MEKI + SDI written approval (docs/55) ──
PAYMENTS_ENABLED=false
GALA_TICKETING_MODE=zeffy_hosted
GALA_HOSTED_SALES_ENABLED=false
SDI_GALA_GIVING_ENABLED=false
GENERAL_GIVING_AUTHORIZED=false
PROGRAMME_GIVING_AUTHORIZED=false
SDI_GENERAL_GIVING_ENABLED=false
SDI_PROGRAMME_GIVING_ENABLED=false
SDI_REPORT_APPLY_ENABLED=false
SDI_MANUAL_CONFIRMATION_ENABLED=false
GIVING_GALA_ONLY_MODE=false
GIVING_GALA_EVENT_SLUG=gala-night
SDI_PROGRAMME_DESIGNATION_CONFIRMED=false
# Phase 14 (docs/61): donation intents, Donation Type, Zakat — each ONLY after SDI confirms the form question AND its export
SDI_DONATION_REFERENCE_CONFIRMED=false
SDI_DONATION_TYPE_CONFIRMED=false
ZAKAT_GIVING_ENABLED=false
ZEFFY_GALA_AUTO_CONFIRM=false
ZEFFY_RECONCILIATION_ENABLED=false
ALLOW_DEMO_PUBLISH=false
