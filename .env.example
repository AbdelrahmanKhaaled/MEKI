# Examples only. NEVER commit actual credentials.
NODE_ENV=development
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
# Public website: the API base INCLUDING /api/v1 (the web app appends paths like /public/home). Without the prefix the site
# silently falls back to its built-in content. See apps/web/.env.example.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# MySQL 8.x - replace with private local credentials in apps/api/.env
DATABASE_URL=mysql://meki_user:CHANGE_ME@127.0.0.1:3307/meki_dev
# Payment integration will be configured only after provider approval.
# PAYMENT_PROVIDER=
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=
