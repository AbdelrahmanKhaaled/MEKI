{
  "name": "@meki/api",
  "version": "0.1.0",
  "private": true,
  "description": "MEKI core backend API (NestJS modular monolith, MySQL 8 + Prisma)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "prisma generate && jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "tsx prisma/seed-dev-accounts.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "openapi:export": "nest build && node dist/openapi-export.js"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/swagger": "^11",
    "@nestjs/throttler": "^6",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^11",
    "@nestjs/testing": "^11",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5",
    "@types/jest": "^30",
    "@types/multer": "^2.3.0",
    "@types/node": "^22",
    "@types/supertest": "^7.2.1",
    "eslint": "^9",
    "globals": "^17.14.0",
    "jest": "^30",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8"
  }
}
