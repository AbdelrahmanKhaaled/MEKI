  formUrl              String?  @db.VarChar(1000)
  classification       String?  @db.VarChar(10)
  emailMessageId       String?  @db.VarChar(255)
  emailFrom            String?  @db.VarChar(191)
  emailTo              String?  @db.VarChar(191)
  emailReceivedAt      DateTime? @db.DateTime(3)
  protectedReference   String?  @db.VarChar(255)
  originalSdiEmail     Boolean  @default(false)
