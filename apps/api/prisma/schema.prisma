/// Immutable ledger of VERIFIED ticket-payment events (UPDATE/DELETE blocked by DB triggers).
model EventBookingTransaction {
  id                     String                      @id @default(cuid()) @db.VarChar(30)
  bookingId              String                      @db.VarChar(30)
