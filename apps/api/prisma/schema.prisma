// ───────────────────── event ticketing: Gala booking (Phase 5B) ─────────────────────
// Ticket revenue is NOT a charitable donation: it lives in its own booking-keyed attempt + ledger tables
// (classification EVENT_TICKET_PAYMENT) and never touches Donation / PaymentTransaction, so donation totals,
// campaign allocations, donation refunds and donation receipts are unaffected by construction.
// No fair-market-value / tax-deductible amount is modelled (not provided by the client; SDI handles tax receipts).
// Bookings, guests, tickets and the ticket ledger are never deleted (DB triggers).

enum EventBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum BookingPaymentStatus {
  UNPAID
  PENDING // a hosted checkout session exists; money state is still unverified
  PAID // only from a verified provider event
  FAILED
  REFUNDED
}

enum TicketStatus {
  PENDING
  ISSUED
  CHECKED_IN
  REVOKED
  REFUNDED
}

enum FinancialClassification {
  CHARITABLE_DONATION
  EVENT_TICKET_PAYMENT
}

/// Server-controlled ticket sale configuration for an event. The browser never supplies a price.
model EventTicketConfig {
  id                   String     @id @default(cuid()) @db.VarChar(30)
  eventId              String     @unique @db.VarChar(30)
  event                Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketNameEn         String     @default("Individual ticket") @db.VarChar(120)
  /// Price per guest in `currency` (individual tickets only; no tables)
  ticketPrice          Decimal    @db.Decimal(18, 3)
  currency             String     @default("USD") @db.Char(3)
  /// Closed until MEKI/SDI approve sales; independent of payment-provider availability
  salesEnabled         Boolean    @default(false)
  maxTicketsPerBooking Int        @default(10)
  /// Total sellable tickets; null = no limit configured (never invented)
  capacity             Int?
  /// Text printed on tickets / e-mails (client-confirmed values; separate from the CMS event copy)
  displayNameEn        String     @db.VarChar(255)
  eventDateLabelEn     String     @db.VarChar(120)
  venueLabelEn         String     @db.VarChar(255)
  checkInNoteEn        String?    @db.VarChar(500)
  provenance           Provenance @default(PROPOSED)
  updatedById          String?    @db.VarChar(30)
  createdAt            DateTime   @default(now()) @db.DateTime(3)
  updatedAt            DateTime   @updatedAt @db.DateTime(3)
}

/// One checkout/order containing one or more individual guest tickets.
model EventBooking {
  id                     String                  @id @default(cuid()) @db.VarChar(30)
  /// Public, non-sequential reference (EB-7K3QX9M2PA4T)
  publicReference        String                  @unique @db.VarChar(24)
  /// SHA-256 of the purchaser-facing access token (status / confirmation / ticket download)
  accessTokenHash        String                  @db.Char(64)
  idempotencyKey         String?                 @unique @db.VarChar(80)
  idempotencyRequestHash String?                 @db.Char(64)
  eventId                String                  @db.VarChar(30)
  event                  Event                   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  purchaserName          String                  @db.VarChar(160)
  purchaserEmail         String                  @db.VarChar(191)
  purchaserPhone         String                  @db.VarChar(40)
  guestCount             Int
  /// Server-calculated: unitPrice x guestCount
  unitPrice              Decimal                 @db.Decimal(18, 3)
  totalAmount            Decimal                 @db.Decimal(18, 3)
  currency               String                  @db.Char(3)
  classification         FinancialClassification @default(EVENT_TICKET_PAYMENT)
  bookingStatus          EventBookingStatus      @default(PENDING)
  paymentStatus          BookingPaymentStatus    @default(UNPAID)
  paymentProvider        String?                 @db.VarChar(40)
  /// Provider checkout session / payment reference once known
  providerReference      String?                 @db.VarChar(191)
  refundedAmount         Decimal                 @default(0) @db.Decimal(18, 3)
  /// Phase 12: who issues the official tickets. ZEFFY = SDI's hosted form issues tickets, PDFs, QR codes and check-in;
  /// MEKI never issues, regenerates or e-mails tickets for such a booking (no MEKI ticket rows exist for it).
  ticketIssuer           GalaTicketIssuer        @default(MEKI)
  /// Phase 12: paid ticket count as reported by SDI (authoritative for ZEFFY bookings; may differ from the intended guestCount)
  reportedTicketCount    Int?
  isTest                 Boolean                 @default(false)
  locale                 String                  @default("en") @db.VarChar(5)
  paidAt                 DateTime?               @db.DateTime(3)
  cancelledAt            DateTime?               @db.DateTime(3)
  cancelReason           String?                 @db.VarChar(500)
  createdAt              DateTime                @default(now()) @db.DateTime(3)
  updatedAt              DateTime                @updatedAt @db.DateTime(3)

  guests       EventBookingGuest[]
  tickets      EventTicket[]
  attempts     EventBookingPaymentAttempt[]
  transactions EventBookingTransaction[]
  jobs         EventBookingJob[]

  @@index([eventId, bookingStatus, paymentStatus])
  @@index([purchaserEmail])
  @@index([createdAt])
}

model EventBookingGuest {
