  reportImportId       String?  @db.VarChar(30)
  createdAt            DateTime @default(now()) @db.DateTime(3)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([externalPaymentId])
}

model ProviderPayment {
  id                      String                     @id @default(cuid()) @db.VarChar(30)
  provider                String                     @db.VarChar(40)
  providerPaymentId       String                     @db.VarChar(64)
  /// Provider status as reported (e.g. succeeded / pending / failed)
  status                  String                     @db.VarChar(40)
  /// online | manual | imported
  type                    String                     @db.VarChar(20)
  /// Converted exactly from the provider's integer cents
  amount                  Decimal                    @db.Decimal(18, 2)
  eligibleAmount          Decimal                    @db.Decimal(18, 2)
  /// Sum of SUCCEEDED provider refunds
  refundedAmount          Decimal                    @default(0) @db.Decimal(18, 2)
  /// none | partial | full
  refundStatus            String                     @db.VarChar(20)
  disputeStatus           String?                    @db.VarChar(30)
  currency                String                     @db.Char(3)
  campaignId              String?                    @db.VarChar(64)
  campaignCategory        String?                    @db.VarChar(30)
  occurrenceId            String?                    @db.VarChar(64)
  recurringSubscriptionId String?                    @db.VarChar(64)
  recurringInterval       String?                    @db.VarChar(20)
  classification          FinancialClassification?
  /// Item lines without personal data: [{ type, amount, rateId, rateTitle }]
  items                   Json
  /// MEKI reference found in the buyer's answers (never trusted alone)
  correlationRef          String?                    @db.VarChar(40)
  matchStatus             ProviderPaymentMatchStatus @default(UNMATCHED)
  matchReason             String?                    @db.VarChar(200)
  matchedEntityType       String?                    @db.VarChar(40)
  matchedEntityId         String?                    @db.VarChar(30)
  providerCreatedAt       DateTime                   @db.DateTime(3)
  /// The provider reported the payment deleted (404 / payment.deleted). Accounting is never reversed automatically.
  deletedAtProvider       DateTime?                  @db.DateTime(3)
  lastEventId             String?                    @db.VarChar(80)
  lastSyncedAt            DateTime                   @db.DateTime(3)
  createdAt               DateTime                   @default(now()) @db.DateTime(3)
  updatedAt               DateTime                   @updatedAt @db.DateTime(3)

  @@unique([provider, providerPaymentId])
  /// one provider payment per MEKI record (NULLs are not compared, so unmatched rows are unaffected)
  @@unique([provider, matchedEntityType, matchedEntityId])
  @@index([matchStatus])
  @@index([campaignId])
  @@index([providerCreatedAt])
}

// ───────────────────────────── Phase 12: SDI hosted forms + report reconciliation ─────────────────────────────

enum GalaTicketIssuer {
  MEKI // legacy / development: MEKI issues PDF + QR tickets after a verified payment
  ZEFFY // production (SDI decision 2026-11): Zeffy hosted form issues tickets, QR codes, receipts and check-in
}

enum ProviderReportKind {
  RECONCILIATION // daily order report: booking reference, ticket type, amount, status, date (refunds/cancellations)
  ATTENDEES // attendee list: guest names, ticket types, table numbers, custom answers (operational, NOT proof of payment)
}

enum ProviderReportStatus {
  UPLOADED // file stored privately and its headers read; nothing interpreted yet
  PREVIEWED // rows parsed, validated and matched; NOTHING applied
  APPLIED // approved by a second administrator and applied in one transaction
  REJECTED // closed without applying
}

enum ProviderReportRowStatus {
  MATCHED // every rule passed; applied only on approval
  UNMATCHED // well-formed reference that matches no MEKI booking (or no reference at all)
  AMBIGUOUS // more than one order claims the same booking, or one order conflicts with another
  INVALID_REFERENCE // reference present but not a valid MEKI booking reference format
  AMOUNT_MISMATCH // amount / quantity / currency inconsistent with the booking
  DUPLICATE_ROW // the same order appears twice in this file with conflicting data
  STALE // older than the state already recorded for this order (out-of-order report)
  ALREADY_APPLIED // identical state already applied from an earlier report (idempotent no-op)
  REQUIRES_REVIEW // valid but must be handled by a person (e.g. partial context, donation line, paid → cancelled)
  INVALID // the row failed validation (amount, date, currency, formula-like value, missing order id)
  INFO // attendee rows: informational only
}

/**
 * One uploaded SDI report. Uploading never changes financial state; applying requires a second administrator.
 */
model ProviderReportImport {
  id               String               @id @default(cuid()) @db.VarChar(30)
  source           String               @default("SDI") @db.VarChar(20)
  kind             ProviderReportKind
  status           ProviderReportStatus @default(UPLOADED)
  fileName         String               @db.VarChar(255)
  /// SHA-256 of the exact uploaded bytes (duplicate-file detection)
  fileSha256       String               @db.Char(64)
  fileSize         Int
  fileType         String               @db.VarChar(10)
  /// private storage key (never a public URL)
  storageKey       String               @db.VarChar(255)
  /// column names only (no cell values)
  headers          Json
  /// the column mapping used for the preview / apply
  mapping          Json?
  mappingProfileId String?              @db.VarChar(30)
  /// explicitly labelled synthetic fixture: may never be applied in staging/production; ledger entries are isTest
  isSynthetic      Boolean              @default(false)
  periodFrom       DateTime?            @db.DateTime(3)
  periodTo         DateTime?            @db.DateTime(3)
  rowCount         Int                  @default(0)
  acceptedCount    Int                  @default(0)
  rejectedCount    Int                  @default(0)
  summary          Json?
  /// re-import of a corrected file for the same period
  supersedesId     String?              @db.VarChar(30)
  uploadedById     String               @db.VarChar(30)
  uploadedAt       DateTime             @default(now()) @db.DateTime(3)
  previewedAt      DateTime?            @db.DateTime(3)
  approvedById     String?              @db.VarChar(30)
  appliedAt        DateTime?            @db.DateTime(3)
  rejectedById     String?              @db.VarChar(30)
  rejectedAt       DateTime?            @db.DateTime(3)
  rejectReason     String?              @db.VarChar(500)
  notes            String?              @db.Text
  rows             ProviderReportRow[]
  attendees        SdiAttendee[]

  @@unique([source, kind, fileSha256])
  @@index([kind, status])
  @@index([uploadedAt])
}

/**
 * One interpreted reconciliation row. Only mapped, non-personal columns are stored (no buyer name / e-mail / address).
 */
model ProviderReportRow {
  id                   String                  @id @default(cuid()) @db.VarChar(30)
  importId             String                  @db.VarChar(30)
  import               ProviderReportImport    @relation(fields: [importId], references: [id], onDelete: Restrict)
  rowNumber            Int
  sourceOrderId        String?                 @db.VarChar(64)
  bookingReferenceRaw  String?                 @db.VarChar(80)
  bookingReference     String?                 @db.VarChar(20)
  ticketType           String?                 @db.VarChar(120)
  /// TICKET | DONATION | UNKNOWN (from the mapping's line-type rules; donation lines are never ledgered automatically)
  lineKind             String                  @db.VarChar(12)
  quantity             Int?
  amount               Decimal?                @db.Decimal(18, 2)
  refundedAmount       Decimal?                @db.Decimal(18, 2)
  currency             String?                 @db.Char(3)
  statusRaw            String?                 @db.VarChar(60)
  /// COMPLETED | PENDING | FAILED | CANCELLED | REFUNDED | PARTIALLY_REFUNDED | UNKNOWN
  status               String?                 @db.VarChar(20)
  occurredAt           DateTime?               @db.DateTime(3)
  matchStatus          ProviderReportRowStatus
  matchNote            String?                 @db.VarChar(300)
  bookingId            String?                 @db.VarChar(30)
  /// Phase 14: MEKI donation reference (DN-…) as typed / normalised, the matched intent, and the reported type / designation
  donationReferenceRaw String?                 @db.VarChar(80)
  donationReference    String?                 @db.VarChar(20)
  donationId           String?                 @db.VarChar(30)
  donationTypeRaw      String?                 @db.VarChar(60)
  donationType         String?                 @db.VarChar(10)
  designationRaw       String?                 @db.VarChar(120)
  applied              Boolean                 @default(false)
  appliedAt            DateTime?               @db.DateTime(3)
  /// validation messages (codes only)
  errors               Json?
  createdAt            DateTime                @default(now()) @db.DateTime(3)

  @@unique([importId, rowNumber])
  @@index([sourceOrderId])
  @@index([bookingId])
  @@index([donationId])
  @@index([importId, matchStatus])
}

/**
 * Attendee-list row (operational seating information; NOT proof of payment). Restricted to gala.guests.read.
 */
model SdiAttendee {
  id               String               @id @default(cuid()) @db.VarChar(30)
  importId         String               @db.VarChar(30)
  import           ProviderReportImport @relation(fields: [importId], references: [id], onDelete: Restrict)
  rowNumber        Int
  sourceOrderId    String?              @db.VarChar(64)
  bookingReference String?              @db.VarChar(20)
  guestName        String               @db.VarChar(200)
  ticketType       String?              @db.VarChar(120)
  tableLabel       String?              @db.VarChar(40)
  /// only the custom-answer columns explicitly mapped by the importer (sanitised strings)
  answers          Json?
  createdAt        DateTime             @default(now()) @db.DateTime(3)

  @@unique([importId, rowNumber])
  @@index([bookingReference])
}

/**
 * Saved column mappings. A mapping must be verified against a REAL SDI sample before any report using it can be applied.
 */
model ProviderReportMapping {
  id                    String             @id @default(cuid()) @db.VarChar(30)
  source                String             @default("SDI") @db.VarChar(20)
  kind                  ProviderReportKind
  name                  String             @db.VarChar(80)
  mapping               Json
  verifiedAgainstSample Boolean            @default(false)
  verifiedById          String?            @db.VarChar(30)
  verifiedAt            DateTime?          @db.DateTime(3)
  verificationNote      String?            @db.VarChar(500)
  createdById           String             @db.VarChar(30)
  createdAt             DateTime           @default(now()) @db.DateTime(3)
  updatedAt             DateTime           @updatedAt @db.DateTime(3)

  @@unique([source, kind, name])
}

// ───────────────────────────── Phase 12B: SDI agreement — single approved Gala Project ─────────────────────────────

/**
 * Fiscal-sponsor fundraising scope of an event (SDI agreement, 2026-11): Gala proceeds support ONE project in Egypt approved in
 * writing in SDI's Project Plan. Nothing here is ever chosen automatically; every value is entered by an administrator after
 * business sign-off. Approvals are separate steps (events.approve, a different user from the last editor) and any change to the
 * fields an approval depends on clears that approval. Absence of a row = no project selected, nothing authorized.
 */
model EventFundraisingConfig {
  id                               String    @id @default(cuid()) @db.VarChar(30)
  eventId                          String    @unique @db.VarChar(30)
  event                            Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  /// The single approved project (an existing Project/cause record entered by MEKI). Never auto-selected.
  projectId                        String?   @db.VarChar(30)
  project                          Project?  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// Identifies the signed SDI Project Plan (document title / version / date) — free text, entered by MEKI
  projectPlanReference             String?   @db.VarChar(255)
  /// Step 1: MEKI + SDI approved the project in the written Project Plan (recorded by a second administrator)
  projectPlanApprovedAt            DateTime? @db.DateTime(3)
  projectPlanApprovedById          String?   @db.VarChar(30)
  projectPlanApprovalNote          String?   @db.VarChar(500)
  /// Step 2 (separate): public fundraising for this project may be shown and the Gala donation form linked
  fundraisingAuthorizedAt          DateTime? @db.DateTime(3)
  fundraisingAuthorizedById        String?   @db.VarChar(30)
  /// Approved end of the Gala donation campaign (SDI proposed 2027-01-31, pending MEKI approval). Required for public giving.
  donationsCloseAt                 DateTime? @db.DateTime(3)
  /// SDI states donations are not refundable; the notice is shown publicly only after this approval
  donationRefundNoticeApprovedAt   DateTime? @db.DateTime(3)
  donationRefundNoticeApprovedById String?   @db.VarChar(30)
  /// Ticket refund policy is independent of the donation policy; text is published only once approved
  ticketRefundPolicyEn             String?   @db.Text
  ticketRefundPolicyAr             String?   @db.Text
  ticketRefundPolicyApprovedAt     DateTime? @db.DateTime(3)
  ticketRefundPolicyApprovedById   String?   @db.VarChar(30)
  updatedById                      String?   @db.VarChar(30)
  createdAt                        DateTime  @default(now()) @db.DateTime(3)
  updatedAt                        DateTime  @updatedAt @db.DateTime(3)

  @@index([projectId])
}

// ───────────────────────────── Nov 19 2026 update: approval-gated Gala legal copy ─────────────────────────────

/**
 * The three legal drafts MEKI supplied for the Gala (SDI is the fiscal sponsor and the only receipt issuer).
 */
enum LegalCopyKind {
  TICKET_PURCHASE_DISCLOSURE // shown to buyers before they open SDI's form — publishable after SDI approval
  TICKET_RECEIPT // wording for SDI's own receipt configuration — NEVER published or issued by MEKI
  WEBSITE_DISCLOSURE // Gala page disclosure — publishable after SDI approval
}

/**
 * Exact client/SDI wording, entered by an administrator (never generated). Editing clears approval and publication.
 * Publishing requires SDI's written approval recorded by a DIFFERENT administrator (events.approve); the ticket amounts
 * (price = fair market value + potentially deductible portion) must be consistent and match the live ticket price.
 */
model EventLegalCopy {
  id               String        @id @default(cuid()) @db.VarChar(30)
  eventId          String        @db.VarChar(30)
  event            Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  kind             LegalCopyKind
  textEn           String?       @db.Text
  textAr           String?       @db.Text
  /// Breakdown stated in the wording (USD); all three or none
  ticketPrice      Decimal?      @db.Decimal(18, 2)
  fairMarketValue  Decimal?      @db.Decimal(18, 2)
  deductibleAmount Decimal?      @db.Decimal(18, 2)
  currency         String        @default("USD") @db.Char(3)
  /// Where the text came from (e.g. "MEKI draft, e-mail 2026-11-19")
  sourceNote       String?       @db.VarChar(255)
  sdiApprovedAt    DateTime?     @db.DateTime(3)
  sdiApprovedById  String?       @db.VarChar(30)
  /// Reference to SDI's written approval (who, date, channel)
  sdiApprovalNote  String?       @db.VarChar(500)
  publishedAt      DateTime?     @db.DateTime(3)
  publishedById    String?       @db.VarChar(30)
  updatedById      String?       @db.VarChar(30)
  createdAt        DateTime      @default(now()) @db.DateTime(3)
  updatedAt        DateTime      @updatedAt @db.DateTime(3)

  @@unique([eventId, kind])
}
