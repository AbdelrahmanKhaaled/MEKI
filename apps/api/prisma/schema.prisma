  @@index([classification, type, status])
  @@index([occurredAt])
}

// ───────────── retryable background work for ticket bookings (Phase 5B.1 outbox) ─────────────
// Rows are written INSIDE the payment-confirmation transaction (outbox pattern), so a verified payment can never be
// "confirmed but forgotten": PDF generation and e-mail delivery are retried with back-off and never roll back the payment.

enum EventJobType {
  TICKET_PDF
  EMAIL
}

enum EventJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED // gave up after the maximum number of attempts (admin can re-queue)
  SKIPPED // nothing to do / no e-mail provider configured (admin can re-queue)
}

model EventBookingJob {
  id          String         @id @default(cuid()) @db.VarChar(30)
  bookingId   String         @db.VarChar(30)
  booking     EventBooking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  type        EventJobType
  /// E-mail template key for EMAIL jobs (booking.pending, booking.confirmed, ticket.delivery, ...)
  template    String?        @db.VarChar(40)
  ticketId    String?        @db.VarChar(30)
  /// One job per logical task: repeated enqueueing (duplicate webhook, retries) cannot create duplicates
  dedupeKey   String         @unique @db.VarChar(120)
  status      EventJobStatus @default(PENDING)
  attempts    Int            @default(0)
  nextRunAt   DateTime       @default(now()) @db.DateTime(3)
  /// Lease so two runners never execute the same job; expired leases are recoverable
  lockedUntil DateTime?      @db.DateTime(3)
  /// Sanitised (no e-mail addresses / tokens), truncated
  lastError   String?        @db.VarChar(500)
  completedAt DateTime?      @db.DateTime(3)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)

  @@index([status, nextRunAt])
  @@index([bookingId])
}

// ───────────── Phase 8A: provider-side payment records (SDI's Zeffy account) ─────────────
// A READ MODEL of payments that exist in SDI's Zeffy account, filled from verified webhooks and read-only API reconciliation.
// It never moves money and is not a ledger: MEKI's ledgers (PaymentTransaction / EventBookingTransaction) are written only
// through the established confirmation pipelines. It exists because a provider payment can arrive before (or without) any MEKI
// record it could be attached to, and those payments must stay visible for review instead of being dropped or guessed.

enum ProviderPaymentMatchStatus {
  UNMATCHED // no MEKI reference in the provider record (e.g. a donation made directly on SDI's form)
  NEEDS_REVIEW // a reference exists but a correlation rule failed or is ambiguous: never applied automatically
  MATCHED // every correlation rule passed; not applied (automatic confirmation disabled)
  CONFIRMED // applied once through the established booking pipeline
  IGNORED // outside MEKI's configured campaigns
}

/// Private evidence queue. Original evidence is retained in the finance-controlled archive;
/// this table stores its opaque archive reference, never a public media URL.
model ManualPaymentEvidence {
  id                   String   @id @default(cuid()) @db.VarChar(30)
