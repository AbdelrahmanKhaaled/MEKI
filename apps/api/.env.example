# Copy to apps/api/.env. NEVER commit real credentials.
NODE_ENV=development
PORT=4000
# Dedicated MEKI MySQL 8 database (utf8mb4). Use a different DB for tests (.env.test -> *_test).
DATABASE_URL=mysql://meki_user:CHANGE_ME@127.0.0.1:3307/meki_dev
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# local | s3 (s3 driver is a placeholder until hosting is confirmed)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage/uploads
PUBLIC_MEDIA_BASE_URL=http://localhost:4000/media
MEDIA_MAX_UPLOAD_MB=10
# Payments stay disabled until provider, merchant account, compliance and E2E tests are approved.
PAYMENTS_ENABLED=false
# PAYMENT_PROVIDER=
# Allow publishing DEMO-provenance content (staging only). Must be false in production.
ALLOW_DEMO_PUBLISH=false
# One-time bootstrap for the first Super Admin (pnpm --filter @meki/api admin:bootstrap)
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_NAME=
# ── Donations & payments (Phase 3) ──
# PAYMENT_PROVIDER=          # implemented: mock (development/test ONLY; rejected in staging/production)
# MOCK_PAYMENT_WEBHOOK_SECRET=   # >=16 chars, only for PAYMENT_PROVIDER=mock
# DONATION_TOKEN_SECRET=     # >=32 chars, required when PAYMENTS_ENABLED=true
DONATION_RATE_LIMIT_PER_MINUTE=10
PAYMENT_SESSION_TTL_MINUTES=30
RECURRING_MAX_RETRY_ATTEMPTS=3
RECURRING_RETRY_INTERVAL_DAYS=3
RECEIPTS_AUTO_ISSUE=true
DONATION_RETURN_URL=http://localhost:3000/en/donation/return
# Security/infra
LOGIN_RATE_LIMIT_PER_MINUTE=5
# TRUST_PROXY=1               # hop count or subnet list; never "true"
RATE_LIMIT_STORE=memory       # redis requires REDIS_URL + adapter (multi-instance)
MEDIA_PUBLIC_CONSENT_MODE=not_denied   # or confirmed_only (client decision)
