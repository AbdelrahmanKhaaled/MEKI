# Copy to apps/api/.env. NEVER commit real credentials.
NODE_ENV=development
PORT=4000
# Dedicated MEKI MySQL 8 database (utf8mb4). Use a different DB for tests (.env.test -> *_test).
DATABASE_URL=mysql://meki_user:CHANGE_ME@127.0.0.1:3307/meki_dev
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# local | s3 (s3 driver is a placeholder until hosting is confirmed)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage/uploads
PUBLIC_MEDIA_BASE_URL=http://localhost:4000/media
MEDIA_MAX_UPLOAD_MB=10
# Payments stay disabled until provider, merchant account, compliance and E2E tests are approved.
PAYMENTS_ENABLED=false
# PAYMENT_PROVIDER=
# Allow publishing DEMO-provenance content (staging only). Must be false in production.
ALLOW_DEMO_PUBLISH=false
# One-time bootstrap for the first Super Admin (pnpm --filter @meki/api admin:bootstrap)
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_NAME=
# ── Donations & payments (Phase 3) ──
# PAYMENT_PROVIDER=          # implemented: mock (development/test ONLY; rejected in staging/production)
# MOCK_PAYMENT_WEBHOOK_SECRET=   # >=16 chars, only for PAYMENT_PROVIDER=mock
# DONATION_TOKEN_SECRET=     # >=32 chars, required when PAYMENTS_ENABLED=true
DONATION_RATE_LIMIT_PER_MINUTE=10
PAYMENT_SESSION_TTL_MINUTES=30
RECURRING_MAX_RETRY_ATTEMPTS=3
RECURRING_RETRY_INTERVAL_DAYS=3
RECEIPTS_AUTO_ISSUE=true
DONATION_RETURN_URL=http://localhost:3000/en/donation/return
# Security/infra
LOGIN_RATE_LIMIT_PER_MINUTE=5
# TRUST_PROXY=1               # hop count or subnet list; never "true"
RATE_LIMIT_STORE=memory       # redis requires REDIS_URL + adapter (multi-instance)
MEDIA_PUBLIC_CONSENT_MODE=not_denied   # or confirmed_only (client decision)
# ── Event ticketing / Gala (Phase 5B) ──
# EVENT_BOOKING_TOKEN_SECRET=   # >=32 chars; falls back to DONATION_TOKEN_SECRET when unset
EVENT_BOOKING_RETURN_URL=http://localhost:3000/{locale}/events/{slug}/booking
EVENT_BOOKING_HOLD_MINUTES=60
# Private (never web-served) storage for ticket PDFs
PRIVATE_STORAGE_DIR=./storage/private
# TICKET_PDF_UNICODE_FONT_PATH=  # optional TTF with Arabic coverage for guest names on tickets
# ── Ticket PDFs, e-mail and background jobs (Phase 5B.1) ──
# Bundled Noto Sans / Noto Sans Arabic (SIL OFL) are used by default; override only with approved fonts (TTF/OTF, must exist):
# TICKET_PDF_UNICODE_FONT_PATH=        # Arabic-capable regular
# TICKET_PDF_UNICODE_FONT_BOLD_PATH=   # Arabic-capable bold
# TICKET_PDF_LATIN_FONT_PATH=
# TICKET_PDF_LATIN_FONT_BOLD_PATH=
# ASSETS_DIR=                          # default: apps/api/assets, then dist/assets
# none = no provider (e-mails are parked, nothing is sent) | dev-file = write messages to MAIL_DEV_OUTBOX_DIR (dev only)
MAIL_TRANSPORT=none
MAIL_DEV_OUTBOX_DIR=./storage/mail-outbox
GALA_JOBS_INTERVAL_SECONDS=30
GALA_JOB_MAX_ATTEMPTS=5
GALA_EMAIL_ARABIC_APPROVED=false

# ── Zeffy / SDI (Phase 8A) — all optional; the integration stays OFF until SDI supplies these (docs/31, docs/32). ──
# Never commit real values. Provide them through the hosting secret store; SDI must send secrets through an encrypted channel.
# ZEFFY_API_BASE_URL=https://api.zeffy.com
# ZEFFY_API_KEY=                       # SDI org API key (server-side only; read access is all MEKI uses)
# ZEFFY_WEBHOOK_SECRET=                # signing secret(s), comma-separated during rotation
# ZEFFY_WEBHOOK_TOLERANCE_SECONDS=300
# ZEFFY_RECONCILIATION_ENABLED=false
# ZEFFY_RECONCILIATION_INTERVAL_MINUTES=30
# ZEFFY_GALA_TICKET_CAMPAIGN_ID=       # Zeffy campaign (form) id of the Gala ticket form
# ZEFFY_GALA_EVENT_CODE=EVT-GALA-NIGHT
# ZEFFY_DONATION_CAMPAIGN_IDS=         # comma-separated
# ZEFFY_GALA_AUTO_CONFIRM=false        # refused in staging/production until SDI confirms the booking-reference mapping
# ZEFFY_DONATION_FORM_URL=             # https://www.zeffy.com/... (approved hosted forms only)
# ZEFFY_GALA_TICKET_FORM_URL=
# ZEFFY_GALA_GIVING_FORM_URL=

# ── SDI hosted forms (Phase 12; docs/47–49). SDI's decision: payments ONLY on SDI's Zeffy forms, no API key, no webhooks; a daily
#    reconciliation report confirms bookings. Every switch below is OFF by default; turning one on needs MEKI + SDI sign-off.
# GALA_TICKETING_MODE=                 # meki | zeffy_hosted. Default: zeffy_hosted in staging/production (meki refused there), meki elsewhere
# GALA_HOSTED_SALES_ENABLED=false      # shows the SDI Gala form link; needs zeffy_hosted + ZEFFY_GALA_TICKET_FORM_URL
#   (SDI-provided Gala form: https://www.zeffy.com/en-US/ticketing/misr-el-kheir-foundation-gala-new-york — set it only when sales are approved)
# SDI_BOOKING_REFERENCE_QUESTION=MEKI Booking Reference   # exact label of SDI's custom question
# SDI_GENERAL_GIVING_ENABLED=false     # needs ZEFFY_DONATION_FORM_URL
# SDI_PROGRAMME_GIVING_ENABLED=false   # needs SDI_PROGRAMME_DESIGNATION_CONFIRMED=true and SDI_PROGRAMME_FORM_URLS
# SDI_PROGRAMME_DESIGNATION_CONFIRMED=false
# SDI_PROGRAMME_FORM_URLS=             # JSON {"<programme-slug>":"https://www.zeffy.com/..."} — SDI-provided URLs only
# SDI_REPORT_APPLY_ENABLED=false       # allow approved reports to change bookings; enable after a REAL SDI sample is verified
# Reports are stored under PRIVATE_STORAGE_DIR/sdi-reports (never public). ZEFFY_GALA_AUTO_CONFIRM must stay false in zeffy_hosted mode.
