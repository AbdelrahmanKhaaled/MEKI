# Public website (apps/web) — examples only, never real secrets. Copy to .env.local for development.
# NEXT_PUBLIC_* values are inlined at BUILD time: changing them requires a rebuild.

# API base INCLUDING /api/v1. Browser calls (booking, donation status) use it; it must be reachable by visitors.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Optional server-side base for SSR/ISR fetches (private network address); falls back to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://api.internal:4000/api/v1
# CMS live publishing (server-only, runtime): shared secret the API sends to /api/internal/revalidate after a publish. Same value
# as the API's MEKI_REVALIDATE_SECRET; at least 32 characters. Unset → the route answers 503 and pages refresh every 300 s.
# MEKI_REVALIDATE_SECRET=
# Public origin for canonical / Open Graph / sitemap URLs (required in production; without it no absolute URLs are emitted).
# NEXT_PUBLIC_SITE_URL=https://www.example.org
# Hosted-checkout host names the booking page may redirect to (comma separated). Empty = never redirect (sales stay closed).
# NEXT_PUBLIC_CHECKOUT_ALLOWED_HOSTS=givebutter.com,www.givebutter.com,www.zeffy.com
# Release switches for the hand-off to SDI's OFFICIAL Gala forms (URLs are fixed in src/lib/official-forms.ts).
# Only the exact value "true" enables a hand-off. Turn on only after SDI opens the form for collection. Requires a rebuild.
# They are used when the MEKI reference flow is not open, including when the API is unreachable.
# NEXT_PUBLIC_GALA_TICKET_FORM_HANDOFF=false
# NEXT_PUBLIC_GALA_DONATION_FORM_HANDOFF=false
