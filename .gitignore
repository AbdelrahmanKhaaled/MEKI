# Original client materials and proprietary imagery (local only)
/client-resources/**
!/client-resources/.gitkeep
# Secrets and local overrides
.env
.env.*
*.env
.aws/
!.env.example
!.env.*.example
*.pem
*.key
*.p12
# Dependencies, builds and logs
node_modules/
.pnpm-store/
.next/
dist/
build/
coverage/
.turbo/
*.log
# IDE / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
# temp
.tmp/
tmp/
# Prisma local/generated DB artifacts (do not ignore migrations)
*.db
*.db-journal
# large archives
*.zip
*.7z
*.rar
*.tsbuildinfo
# Phase 13A — staging rehearsal data and backups (may contain personal data) are never committed
deploy/**/backups/
deploy/**/data/

# Client-supplied proprietary documents (CLAUDE.md: never commit client resources)
docs/client-requirements/
# Client edit packages (Word briefs, screenshots, original logos/photos, sponsorship PDF) — reference only, never committed.
# Packaged site media live in apps/web/public. The CMS sync reads originals from a separate operator delivery.
/references/
